# Copy to a local .env or use the client's configure command. Never commit a real key.
SALPX_API_KEY=sk-your-salpx-key
SALPX_BASE_URL=https://www.salpx.com/v1
SALPX_IMAGE_MODEL=gpt-image-2.6-sunburst
SALPX_DRAFT_IMAGE_MODEL=gpt-image-2.6-sunburst
SALPX_REFINE_IMAGE_MODEL=gpt-image-2.6-sunburst
SALPX_VIDEO_MODEL=omni_flash
